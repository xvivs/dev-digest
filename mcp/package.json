{
  "name": "@devdigest/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "devdigest-mcp: a local stdio MCP server that is a thin HTTP client of the DevDigest API",
  "scripts": {
    "start": "tsx src/index.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector@2.9.0 ./node_modules/.bin/tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
